{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "griddle",
	"compatibility_date": "2026-10-01",
	// The built app in ./dist. Only /api/* runs the Worker (worker/index.ts): Send feedback.
	// Secrets: NOTION_FEEDBACK_TOKEN and NOTION_FEEDBACK_DATA_SOURCE_ID (npx wrangler secret put …).
	"main": "./worker/index.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	"routes": [{ "pattern": "griddle.thomasjfrank.com", "custom_domain": true }]
}
