{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "griddle",
	"compatibility_date": "2026-10-01",
	// Static site only: the built app in ./dist, no server code.
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application"
	},
	"routes": [{ "pattern": "griddle.thomasjfrank.com", "custom_domain": true }]
}
